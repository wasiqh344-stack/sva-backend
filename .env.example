# ---- Server ----
PORT=3000
NODE_ENV=production

# Comma-separated list of origins allowed to call this API.
# Use "*" while testing; set to your real frontend domain once it's live,
# e.g. https://svadesign.com
CORS_ORIGIN=*

# ---- JWT (admin auth) ----
# Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Resend (email notifications) ----
# Sign up free at https://resend.com, create an API key under "API Keys".
# Without your own verified domain, Resend can only send FROM its shared
# onboarding@resend.dev address TO the email you signed up with.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFY_EMAIL=you@example.com

# ---- Admin signup protection ----
# Required as a header (x-signup-secret) to create NEW admin accounts via
# /api/admin/signup. Keeps random visitors from signing themselves up as admin.
ADMIN_SIGNUP_SECRET=change_this_signup_secret
